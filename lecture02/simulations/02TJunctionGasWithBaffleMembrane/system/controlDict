FoamFile
{
    format      ascii;
    class       dictionary;
    location    "system";
    object      controlDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

application     foamRun;

solver          multicomponentFluid;

startFrom       latestTime;

startTime       0;

stopAt          endTime;

endTime         30.0;

deltaT          1e-5;

writeControl    adjustableRunTime;

writeInterval   2.0;

purgeWrite      0;

writeFormat     ascii;

writePrecision  6;

writeCompression off;

timeFormat      general;

timePrecision   6;

runTimeModifiable true;

adjustTimeStep  yes;

maxCo           1e-1;

maxDeltaT       1e-1;

libs            ( "libspecieTransfer.so" );

functions
{

    #includeFunc patchFlowRateInlet
    
    #includeFunc patchFlowRateOutlet1
    
    #includeFunc patchFlowRateOutlet2        
    
};

