FoamFile
{
    format      ascii;
    class       volVectorField;
    object      U;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 1 -1 0 0 0 0];

internalField   uniform (0 0 0);

boundaryField
{

    membraneLeft
    {
        type            specieTransferVelocity;
        value           $internalField;
    }
    
    membraneRight
    {
        type            specieTransferVelocity;
        value           $internalField;
    }  

    inlet
    {   
        type            flowRateInletVelocity;
        meanVelocity    0.01;
        profile         laminarBL;
        rho             rho;
        value           $internalField;
    }

    outlet1
    {
        type            zeroGradient;
    }
    
    outlet2
    {
        type            zeroGradient;
    }

    walls
    {
        type            noSlip;
    }

    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
