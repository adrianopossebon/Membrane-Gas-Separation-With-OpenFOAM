FoamFile
{
    format      ascii;
    class       volScalarField;
    object      p;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [1 -1 -2 0 0 0 0];

internalField   uniform 1.01e5;

boundaryField
{
    inlet
    {
        type            fixedFluxPressure;
    }
    
    outlet1
    {
        type            fixedValue;
        value           uniform 1.01e5;
    }
    
    outlet2
    {
        type            fixedValue;
        value           uniform 1.01e5;
    }         

    walls
    {
        type            fixedFluxPressure;
    }

    frontAndBack
    {
        type            empty;
    }
}

// ************************************************************************* //
