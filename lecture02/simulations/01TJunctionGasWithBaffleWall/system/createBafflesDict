FoamFile
{
    format      ascii;
    class       dictionary;
    object      createBafflesDict;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

internalFacesOnly true;

baffles
{

    membrane
    {
        type        faceZone;
        zoneName    membrane;

        owner
        {
            name        membraneLeft;
            type        mappedWall;
            neighbourPatch membraneRight;
        }

        neighbour
        {
            name        membraneRight;
            type        mappedWall;
            neighbourPatch membraneLeft;
        }   
    }

}


